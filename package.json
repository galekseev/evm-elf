{
  "name": "@camoseed/evm-elf",
  "version": "1.0.0",
  "description": "Multi-chain EVM CLI for wallets and contracts",
  "keywords": [
    "evm",
    "ethereum",
    "cli",
    "wallet",
    "multichain",
    "proxy",
    "ethers"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galekseev/evm-elf.git"
  },
  "homepage": "https://github.com/galekseev/evm-elf#readme",
  "bugs": {
    "url": "https://github.com/galekseev/evm-elf/issues"
  },
  "type": "module",
  "bin": {
    "evm": "dist/index.js"
  },
  "files": [
    "dist",
    "config"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "prepublishOnly": "npm run clean && npm run lint && npm run typecheck",
    "release": "npm version patch && git push --follow-tags",
    "evm": "tsx index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:acceptance": "vitest run --project acceptance",
    "test:characterization": "vitest run --project characterization",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p test",
    "lint": "eslint .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
